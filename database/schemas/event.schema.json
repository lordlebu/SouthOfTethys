{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "required": [
    "id",
    "type",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^event_[a-z0-9_]+$"
    },
    "type": {
      "const": "event"
    },
    "title": {
      "type": "string"
    },
    "epoch": {
      "type": [
        "string",
        "null"
      ]
    },
    "date_approx": {
      "type": [
        "string",
        "null"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predecessors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "successors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "canon": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "draft"
      ],
      "default": "primary"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

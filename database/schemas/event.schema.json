{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "required": [
    "id",
    "type",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^event_[a-z0-9_]+$"
    },
    "type": {
      "const": "event"
    },
    "title": {
      "type": "string"
    },
    "epoch": {
      "type": [
        "string",
        "null"
      ]
    },
    "date_approx": {
      "type": [
        "string",
        "null"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predecessors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "successors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "canon": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "draft"
      ],
      "default": "primary"
    },
    "sample": {
      "type": "boolean",
      "description": "Marks this entity as a retained test fixture rather than canon.\n\nThe Dragon's Spine episode -- an event, the king who fought it, the dragon, and the range it happened in -- was written to exercise the tooling and kept on purpose, because four entities spread across four folders is a genuinely useful thing to test against. It is not part of the story.\n\nMarked on the entity rather than in a registry, so it is visible to anyone reading the file. `lint_story.py` enforces the isolation that makes it safe to keep: nothing that is not itself a sample may reference a sample, so the fixture cannot quietly become load-bearing."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Character",
  "type": "object",
  "required": [
    "id",
    "type",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^character_[a-z0-9_]+$"
    },
    "type": {
      "const": "character"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epithets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "culture": {
      "type": [
        "string",
        "null"
      ]
    },
    "species": {
      "type": "string",
      "default": "human"
    },
    "status": {
      "type": "string",
      "enum": [
        "alive",
        "deceased",
        "unknown",
        "mythic"
      ]
    },
    "epoch": {
      "type": [
        "string",
        "null"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "object",
      "properties": {
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "siblings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spouse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "One spouse, none, or several -- Khadi, Meera and Mehme each have more than one."
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "physical": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    },
    "canon": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "draft"
      ],
      "default": "primary"
    },
    "sample": {
      "type": "boolean",
      "description": "Marks this entity as a retained test fixture rather than canon.\n\nThe Dragon's Spine episode -- an event, the king who fought it, the dragon, and the range it happened in -- was written to exercise the tooling and kept on purpose, because four entities spread across four folders is a genuinely useful thing to test against. It is not part of the story.\n\nMarked on the entity rather than in a registry, so it is visible to anyone reading the file. `lint_story.py` enforces the isolation that makes it safe to keep: nothing that is not itself a sample may reference a sample, so the fixture cannot quietly become load-bearing."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
